# Required in production
ADMIN_PASSWORD=change-me-to-a-long-random-password
SESSION_SECRET=change-me-to-another-long-random-string

# Neon (or any Postgres) connection string. If omitted locally, the app uses SQLite at data/local.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

PORT=3000
NODE_ENV=development

# Branding — change these before a public launch
COMPANY_NAME=Atlanta Roof Check
COMPANY_LEGAL_NAME=Atlanta Roof Check
SUPPORT_EMAIL=hello@example.com
PUBLIC_BASE_URL=http://localhost:3000

# Optional email alerts via Resend HTTP API (do not use SMTP on Render's free tier)
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL=you@example.com
# FROM_EMAIL=Atlanta Roof Check <alerts@yourdomain.com>
